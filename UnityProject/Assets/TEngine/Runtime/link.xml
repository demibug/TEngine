<linker>
  <!--
    事件注册链保留：GameEventHelper / EventAssemblyRegistrarAttribute / IEventAssemblyRegistrar
    只被热更程序集（GameApp 反射入口链）引用，UnityLinker 分析 AOT 主包时不可见，必须显式保留。
  -->
  <assembly fullname="TEngine.Runtime">
    <type fullname="TEngine.GameEventHelper" preserve="all" />
    <type fullname="TEngine.EventAssemblyRegistrarAttribute" preserve="all" />
    <type fullname="TEngine.IEventAssemblyRegistrar" preserve="all" />
  </assembly>
</linker>
